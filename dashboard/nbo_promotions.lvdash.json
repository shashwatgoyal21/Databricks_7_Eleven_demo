{
 "datasets": [
  {
   "name": "kpi_live_day",
   "displayName": "Kpi live day",
   "queryLines": [
    "SELECT COUNT(*)                                                       AS check_ins,\n",
    "       COUNT_IF(decision = 'Offer served')                            AS offers_served,\n",
    "       COUNT_IF(decision = 'Offer served') / COUNT(*)                 AS offer_rate,\n",
    "       COUNT_IF(decision = 'No offer')                                AS suppressed,\n",
    "       COUNT_IF(decision LIKE 'Holdout%')                             AS held_out,\n",
    "       COUNT_IF(trigger = 'Shared location: entered store') / COUNT(*) AS share_via_app_location\n",
    "FROM workspace.nbo_demo.offer_decisions"
   ]
  },
  {
   "name": "decisions_by_hour",
   "displayName": "Decisions by hour",
   "queryLines": [
    "SELECT HOUR(event_ts) AS hour, decision, COUNT(*) AS check_ins\n",
    "FROM workspace.nbo_demo.offer_decisions\n",
    "GROUP BY ALL"
   ]
  },
  {
   "name": "offers_by_promotion",
   "displayName": "Offers by promotion",
   "queryLines": [
    "SELECT p.short_name AS promotion, d.daypart, COUNT(*) AS offers\n",
    "FROM workspace.nbo_demo.offer_decisions d\n",
    "JOIN workspace.nbo_demo.promotions p USING (promotion_id)\n",
    "WHERE d.decision = 'Offer served'\n",
    "GROUP BY ALL"
   ]
  },
  {
   "name": "why_no_offer",
   "displayName": "Why no offer",
   "queryLines": [
    "SELECT reason, COUNT(*) AS check_ins\n",
    "FROM workspace.nbo_demo.offer_decisions\n",
    "WHERE decision = 'No offer'\n",
    "GROUP BY ALL"
   ]
  },
  {
   "name": "endpoint_latency",
   "displayName": "Endpoint latency",
   "queryLines": [
    "SELECT DATE_TRUNC('MINUTE', request_time)        AS minute,\n",
    "       COUNT(*)                                   AS requests,\n",
    "       PERCENTILE(execution_duration_ms, 0.5)     AS p50_ms,\n",
    "       PERCENTILE(execution_duration_ms, 0.95)    AS p95_ms,\n",
    "       COUNT_IF(status_code <> 200)               AS errors\n",
    "FROM workspace.nbo_demo.nbo_decision_payload\n",
    "GROUP BY ALL"
   ]
  },
  {
   "name": "tier_backtest",
   "displayName": "Tier backtest",
   "queryLines": [
    "SELECT p.short_name AS promotion, b.tier, b.measured_uplift, b.treatment_sends, b.holdout_sends\n",
    "FROM workspace.nbo_demo.tier_backtest b\n",
    "JOIN workspace.nbo_demo.promotions p USING (promotion_id)\n",
    "WHERE b.holdout_sends >= 30"
   ]
  },
  {
   "name": "rules_vs_model_trend",
   "displayName": "Rules vs model trend",
   "queryLines": [
    "SELECT month_end, 'Discount spend' AS measure, MEASURE(discount_spend) AS usd\n",
    "FROM workspace.nbo_demo.metrics_promotions\n",
    "GROUP BY month_end\n",
    "UNION ALL\n",
    "SELECT month_end, 'Incremental margin' AS measure, MEASURE(incremental_margin) AS usd\n",
    "FROM workspace.nbo_demo.metrics_promotions\n",
    "GROUP BY month_end"
   ]
  },
  {
   "name": "redemption_vs_lift",
   "displayName": "Redemption vs lift",
   "queryLines": [
    "SELECT promotion, 'Redemption rate' AS measure, MEASURE(redemption_rate) AS rate\n",
    "FROM workspace.nbo_demo.metrics_promotions\n",
    "WHERE send_policy = 'Static rules, all eligible (Apr-Sep)'\n",
    "GROUP BY promotion\n",
    "UNION ALL\n",
    "SELECT promotion, 'Measured lift' AS measure, MEASURE(measured_lift) AS rate\n",
    "FROM workspace.nbo_demo.metrics_promotions\n",
    "WHERE send_policy = 'Static rules, all eligible (Apr-Sep)'\n",
    "GROUP BY promotion"
   ]
  },
  {
   "name": "model_vs_rules",
   "displayName": "Model vs rules",
   "queryLines": [
    "SELECT short_name AS promotion, eligible_members, persuadable_members,\n",
    "       redemption_rate_apr_sep, measured_uplift_apr_sep,\n",
    "       blast_net_margin_per_send AS net_margin_per_month_static_rules,\n",
    "       targeted_net_margin_per_send AS net_margin_per_month_model,\n",
    "       annual_gain_vs_blast\n",
    "FROM workspace.nbo_demo.promo_portfolio\n",
    "ORDER BY opportunity_rank"
   ]
  },
  {
   "name": "exec_pnl",
   "displayName": "Executive P&L by offer program",
   "queryLines": [
    "WITH a AS (\n",
    "  SELECT MAX(CASE WHEN key = 'network_stores' THEN value END) AS stores,\n",
    "         MAX(CASE WHEN key = 'promoted_item_gross_margin' THEN value END) AS gm,\n",
    "         MAX(CASE WHEN key = 'cannibalization_rate' THEN value END) AS cann,\n",
    "         MAX(CASE WHEN key = 'platform_cost_annual' THEN value END) AS platform,\n",
    "         MAX(CASE WHEN key = 'hurdle_rate' THEN value END) AS hurdle\n",
    "  FROM workspace.nbo_demo.finance_assumptions),\n",
    "scope AS (\n",
    "  SELECT (SELECT COUNT(*) FROM workspace.nbo_demo.stores) AS pilot_stores,\n",
    "         (SELECT COUNT(DISTINCT decision_date) FROM workspace.nbo_demo.offer_performance) AS days),\n",
    "p AS (\n",
    "  SELECT promotion_id, SUM(offers_served) AS offers_served, SUM(offers_served + holdout_checkins) AS decisions,\n",
    "         SUM(accepted) / NULLIF(SUM(delivered), 0) AS acceptance_rate,\n",
    "         SUM(incremental_margin) AS im, SUM(discount_cost) AS dc, SUM(compute_cost_usd) AS cc\n",
    "  FROM workspace.nbo_demo.offer_performance GROUP BY promotion_id),\n",
    "k AS (SELECT a.*, a.stores / scope.pilot_stores * 365 / scope.days AS f FROM a, scope),\n",
    "r AS (\n",
    "  SELECT pr.short_name AS promotion, p.offers_served, p.acceptance_rate,\n",
    "         p.im * (1 - k.cann) * k.f / k.gm AS incremental_sales,\n",
    "         p.im * (1 - k.cann) * k.f AS incremental_margin,\n",
    "         p.dc * k.f AS discount_cost, p.cc * k.f AS compute_cost,\n",
    "         k.platform * p.decisions / SUM(p.decisions) OVER () AS platform_cost, k.hurdle\n",
    "  FROM p JOIN k ON TRUE JOIN workspace.nbo_demo.promotions pr USING (promotion_id))\n",
    "SELECT promotion, offers_served, acceptance_rate, incremental_sales, incremental_margin, discount_cost,\n",
    "       compute_cost, platform_cost,\n",
    "       incremental_margin - discount_cost - compute_cost - platform_cost AS operating_profit,\n",
    "       (incremental_margin - discount_cost - compute_cost - platform_cost)\n",
    "         / (discount_cost + compute_cost + platform_cost) AS roic, hurdle\n",
    "FROM r\n"
   ]
  },
  {
   "name": "exec_totals",
   "displayName": "Executive totals",
   "queryLines": [
    "WITH a AS (\n",
    "  SELECT MAX(CASE WHEN key = 'network_stores' THEN value END) AS stores,\n",
    "         MAX(CASE WHEN key = 'promoted_item_gross_margin' THEN value END) AS gm,\n",
    "         MAX(CASE WHEN key = 'cannibalization_rate' THEN value END) AS cann,\n",
    "         MAX(CASE WHEN key = 'platform_cost_annual' THEN value END) AS platform,\n",
    "         MAX(CASE WHEN key = 'hurdle_rate' THEN value END) AS hurdle\n",
    "  FROM workspace.nbo_demo.finance_assumptions),\n",
    "scope AS (\n",
    "  SELECT (SELECT COUNT(*) FROM workspace.nbo_demo.stores) AS pilot_stores,\n",
    "         (SELECT COUNT(DISTINCT decision_date) FROM workspace.nbo_demo.offer_performance) AS days),\n",
    "p AS (\n",
    "  SELECT promotion_id, SUM(offers_served) AS offers_served, SUM(offers_served + holdout_checkins) AS decisions,\n",
    "         SUM(accepted) / NULLIF(SUM(delivered), 0) AS acceptance_rate,\n",
    "         SUM(incremental_margin) AS im, SUM(discount_cost) AS dc, SUM(compute_cost_usd) AS cc\n",
    "  FROM workspace.nbo_demo.offer_performance GROUP BY promotion_id),\n",
    "k AS (SELECT a.*, a.stores / scope.pilot_stores * 365 / scope.days AS f FROM a, scope),\n",
    "r AS (\n",
    "  SELECT pr.short_name AS promotion, p.offers_served, p.acceptance_rate,\n",
    "         p.im * (1 - k.cann) * k.f / k.gm AS incremental_sales,\n",
    "         p.im * (1 - k.cann) * k.f AS incremental_margin,\n",
    "         p.dc * k.f AS discount_cost, p.cc * k.f AS compute_cost,\n",
    "         k.platform * p.decisions / SUM(p.decisions) OVER () AS platform_cost, k.hurdle\n",
    "  FROM p JOIN k ON TRUE JOIN workspace.nbo_demo.promotions pr USING (promotion_id))\n",
    "SELECT SUM(incremental_sales) AS incremental_sales,\n",
    "       SUM(incremental_margin - discount_cost - compute_cost - platform_cost) AS operating_profit,\n",
    "       SUM(incremental_margin - discount_cost - compute_cost - platform_cost)\n",
    "         / SUM(discount_cost + compute_cost + platform_cost) AS roic,\n",
    "       MAX(hurdle) AS hurdle\n",
    "FROM r\n"
   ]
  },
  {
   "name": "exec_daypart",
   "displayName": "Acceptance by daypart",
   "queryLines": [
    "SELECT daypart, SUM(accepted) / NULLIF(SUM(delivered), 0) AS acceptance_rate,\n",
    "       SUM(redeemed) / NULLIF(SUM(offers_served), 0) AS redemption_rate,\n",
    "       SUM(holdout_redeemed) / NULLIF(SUM(holdout_checkins), 0) AS holdout_rate\n",
    "FROM workspace.nbo_demo.offer_performance GROUP BY daypart\n",
    "HAVING SUM(offers_served) >= 100 AND SUM(holdout_checkins) >= 30\n"
   ]
  },
  {
   "name": "exec_region",
   "displayName": "Net return by region",
   "queryLines": [
    "SELECT region, SUM(net_return) AS net_return, SUM(offers_served) AS offers_served\n",
    "FROM workspace.nbo_demo.offer_performance GROUP BY region\n"
   ]
  },
  {
   "name": "exec_proposals",
   "displayName": "Agent proposals",
   "queryLines": [
    "SELECT proposal_date, kind, title, expected_monthly_impact_usd * 12 AS impact_per_year, status, decided_by\n",
    "FROM workspace.nbo_demo.agent_proposals ORDER BY created_at DESC\n"
   ]
  }
 ],
