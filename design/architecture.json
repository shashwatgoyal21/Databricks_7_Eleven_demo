[
  {
    "name": "Agentic Next Best Offer",
    "story": "Customer 360 profiles feed a real-time decision endpoint that picks the best offer for each shopper in milliseconds. A campaign agent watches results and starts, stops and scales offers on its own within guardrails; the endpoint reads the live campaign state on every check-in. The dashboard and app show what the agent did, why, and the profit impact.",
    "rowGrid": true,
    "columns": ["sources", "pipeline", "c360", "models", "serving", "agent", "consume"],
    "nodes": [
      { "id": "src-loyalty", "type": "source", "col": "sources", "label": "Loyalty members", "icon": "inputData", "desc": "Profile, region, opt-ins" },
      { "id": "src-pos", "type": "source", "col": "sources", "label": "POS baskets", "icon": "inputData", "desc": "What each shopper buys" },
      { "id": "src-offers", "type": "source", "col": "sources", "label": "Offer history", "icon": "inputData", "desc": "Past offers and responses" },
      { "id": "src-promos", "type": "source", "col": "sources", "label": "Stores + promotions", "icon": "inputData", "desc": "120 stores, 5 offers" },

      { "id": "lakeflow", "type": "lakeflow-block", "col": "pipeline", "row": 0,
        "params": { "gold_desc": "Program results, offer outcomes" } },

      { "id": "c360", "type": "feature-store", "col": "c360", "row": 0, "label": "Customer 360", "desc": "Yours plugged in, or the sample one" },
      { "id": "lakebase", "type": "lakebase", "col": "c360", "row": 2, "label": "Lakebase", "desc": "Profiles + live campaign state, by key",
        "ai_reasoning": "Holds the online feature store and the campaign state the agent writes, so the endpoint reads both in milliseconds. Campaign state is planned (PLAN.md coverage map), not built yet." },

      { "id": "model-training", "type": "model-training", "col": "models", "row": 0, "label": "Uplift model", "desc": "Will this offer change what they buy?" },
      { "id": "registry", "type": "uc-model-registry", "col": "models", "row": 2, "desc": "nbo_decision_service @prod" },
      { "id": "recommender", "type": "ml-model", "col": "models", "row": 4, "label": "Program scorer", "desc": "Forecasts profit per offer, region, change",
        "ai_reasoning": "nbo_recommender (src/09_recommender.py); feeds the campaign agent's candidate actions." },

      { "id": "model-serving", "type": "model-serving", "col": "serving", "row": 2, "label": "Real-time decision", "desc": "Best offer per shopper, in ms, or none" },
      { "id": "sql-lakehouse", "type": "sql-lakehouse", "col": "serving", "row": 4, "desc": "Results, decisions, agent actions" },

      { "id": "agent", "type": "supervisor-agent", "col": "agent", "row": 4, "label": "Campaign Agent", "desc": "Starts, stops, scales offers on its own",
        "ai_reasoning": "D4: no approval queue; acts within guardrails; human can revert. Agent acting is planned, not built (today it only answers questions and the scorer only proposes)." },

      { "id": "app", "type": "databricks-apps-work", "col": "consume", "row": 0, "label": "Offer agent app", "desc": "Agent activity, guardrails, revert, customer 360" },
      { "id": "dashboard", "type": "ai-bi-dashboard", "col": "consume", "row": 2, "label": "Campaign dashboard", "desc": "Started, stopped, scaled, and the profit impact" },
      { "id": "genie", "type": "genie", "col": "consume", "row": 4 },

      { "id": "db-platform", "type": "db-platform", "pin": { "at": "top-left", "to": "platform-box" } },
      { "id": "governance-block", "type": "governance-block", "pin": { "at": "top-right", "to": "platform-box" },
        "params": { "genie_ontology": false } },

      { "id": "platform-box", "type": "box",
        "wraps": ["src-loyalty", "src-pos", "src-offers", "src-promos", "lakeflow", "c360", "lakebase", "model-training", "registry", "recommender", "model-serving", "sql-lakehouse", "agent", "app", "dashboard", "genie"] },

      { "id": "retailer", "type": "source", "col": "serving", "row": 7, "label": "Retailer app + push", "icon": "file:persona/user", "desc": "Shopper walks in; offer delivered" },
      { "id": "retailer-box", "type": "box", "title": "Retailer stack (unchanged)", "wraps": ["retailer"], "style": { "borderStyle": "dashed" } },

      { "id": "note-guardrails", "type": "note", "text": "Guardrails, not approvals: budget cap, minimum offers before acting, auto-pause below the return target, limited change per run. A human can revert any action.", "below": "agent", "gap": 32 },
      { "id": "note-speed", "type": "note", "text": "Two clocks: each shopper decision takes milliseconds; the agent changes campaigns from days of results.", "rightOf": "retailer-box", "gap": 32 },
      { "id": "note-synthetic", "type": "note", "text": "All shoppers, stores and numbers are synthetic.", "below": "src-promos", "gap": 32 },
      { "id": "note-c360", "type": "note", "text": "Plug in an existing Customer 360: point customer_360_table at your table or a mapping view, list the feature columns, retrain. Needs past offers with a holdout too.", "above": "c360", "gap": 32 }
    ],
    "edges": [
