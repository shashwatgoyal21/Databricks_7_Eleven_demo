{
  "datasets": [
    {
      "name": "kpi_live_day",
      "displayName": "Kpi live day",
      "queryLines": [
        "SELECT COUNT(*)                                                       AS check_ins,\n",
        "       COUNT_IF(decision = 'Offer served')                            AS offers_served,\n",
        "       COUNT_IF(decision = 'Offer served') / COUNT(*)                 AS offer_rate,\n",
        "       COUNT_IF(decision = 'No offer')                                AS suppressed,\n",
        "       COUNT_IF(decision LIKE 'Holdout%')                             AS held_out,\n",
        "       COUNT_IF(trigger = 'Shared location: entered store') / COUNT(*) AS share_via_app_location\n",
        "FROM workspace.nbo_demo.offer_decisions"
      ]
    },
    {
      "name": "decisions_by_hour",
      "displayName": "Decisions by hour",
      "queryLines": [
        "SELECT HOUR(event_ts) AS hour, decision, COUNT(*) AS check_ins\n",
        "FROM workspace.nbo_demo.offer_decisions\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "offers_by_promotion",
      "displayName": "Offers by promotion",
      "queryLines": [
        "SELECT p.short_name AS promotion, d.daypart, COUNT(*) AS offers\n",
        "FROM workspace.nbo_demo.offer_decisions d\n",
        "JOIN workspace.nbo_demo.promotions p USING (promotion_id)\n",
        "WHERE d.decision = 'Offer served'\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "why_no_offer",
      "displayName": "Why no offer",
      "queryLines": [
        "SELECT reason, COUNT(*) AS check_ins\n",
        "FROM workspace.nbo_demo.offer_decisions\n",
        "WHERE decision = 'No offer'\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "endpoint_latency",
      "displayName": "Endpoint latency",
      "queryLines": [
        "SELECT DATE_TRUNC('MINUTE', request_time)        AS minute,\n",
        "       COUNT(*)                                   AS requests,\n",
        "       PERCENTILE(execution_duration_ms, 0.5)     AS p50_ms,\n",
        "       PERCENTILE(execution_duration_ms, 0.95)    AS p95_ms,\n",
        "       COUNT_IF(status_code <> 200)               AS errors\n",
        "FROM workspace.nbo_demo.nbo_decision_payload\n",
        "GROUP BY ALL"
      ]
    },
    {
      "name": "tier_backtest",
      "displayName": "Tier backtest",
      "queryLines": [
        "SELECT p.short_name AS promotion, b.tier, b.measured_uplift, b.treatment_sends, b.holdout_sends\n",
        "FROM workspace.nbo_demo.tier_backtest b\n",
        "JOIN workspace.nbo_demo.promotions p USING (promotion_id)\n",
        "WHERE b.holdout_sends >= 30"
      ]
    },
    {
      "name": "rules_vs_model_trend",
      "displayName": "Rules vs model trend",
      "queryLines": [
        "SELECT month_end, 'Discount spend' AS measure, MEASURE(discount_spend) AS usd\n",
        "FROM workspace.nbo_demo.metrics_promotions\n",
        "GROUP BY month_end\n",
        "UNION ALL\n",
        "SELECT month_end, 'Incremental margin' AS measure, MEASURE(incremental_margin) AS usd\n",
        "FROM workspace.nbo_demo.metrics_promotions\n",
        "GROUP BY month_end"
      ]
    },
    {
      "name": "redemption_vs_lift",
      "displayName": "Redemption vs lift",
      "queryLines": [
        "SELECT promotion, 'Redemption rate' AS measure, MEASURE(redemption_rate) AS rate\n",
        "FROM workspace.nbo_demo.metrics_promotions\n",
        "WHERE send_policy = 'Static rules, all eligible (Apr-Sep)'\n",
        "GROUP BY promotion\n",
        "UNION ALL\n",
        "SELECT promotion, 'Measured lift' AS measure, MEASURE(measured_lift) AS rate\n",
        "FROM workspace.nbo_demo.metrics_promotions\n",
        "WHERE send_policy = 'Static rules, all eligible (Apr-Sep)'\n",
        "GROUP BY promotion"
      ]
    },
    {
      "name": "model_vs_rules",
      "displayName": "Model vs rules",
      "queryLines": [
        "SELECT short_name AS promotion, eligible_members, persuadable_members,\n",
        "       redemption_rate_apr_sep, measured_uplift_apr_sep,\n",
        "       blast_net_margin_per_send AS net_margin_per_month_static_rules,\n",
        "       targeted_net_margin_per_send AS net_margin_per_month_model,\n",
        "       annual_gain_vs_blast\n",
        "FROM workspace.nbo_demo.promo_portfolio\n",
        "ORDER BY opportunity_rank"
      ]
    }
  ],
