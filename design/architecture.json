      { "id": "e-src2", "from": "src-pos", "to": "lakeflow@in-lakeflow-connect", "flow": true },
      { "id": "e-src3", "from": "src-offers", "to": "lakeflow@in-lakeflow-connect", "flow": true },
      { "id": "e-src4", "from": "src-promos", "to": "lakeflow@in-lakeflow-connect", "flow": true },

      { "id": "e-c360", "from": "lakeflow", "to": "c360", "flow": true, "label": "Build profiles" },
      { "id": "e-online", "from": "c360", "to": "lakebase", "flow": true, "label": "Online sync" },
      { "id": "e-train", "from": "c360", "to": "model-training", "flow": true },
      { "id": "e-register", "from": "model-training", "to": "registry", "flow": true },
      { "id": "e-load", "from": "registry", "to": "model-serving", "flow": true, "label": "@prod" },
      { "id": "e-lookup", "from": "lakebase", "to": "model-serving", "flow": true, "label": "Profile + campaign state" },

      { "id": "e-decide", "from": "retailer", "to": "model-serving", "arrow": "both", "label": "Check-in / offer" },
      { "id": "e-inference", "from": "model-serving", "to": "sql-lakehouse", "flow": true, "label": "Every decision logged" },
      { "id": "e-gold", "from": "lakeflow", "to": "sql-lakehouse", "flow": true, "label": "Results" },

      { "id": "e-score-in", "from": "sql-lakehouse", "to": "recommender", "flow": true },
      { "id": "e-score-out", "from": "recommender", "to": "agent", "label": "Forecast per action" },
      { "id": "e-agent-read", "from": "sql-lakehouse", "to": "agent", "flow": true, "label": "Results" },
      { "id": "e-agent-act", "from": "agent", "to": "lakebase", "label": "Start / stop / scale" },
      { "id": "e-agent-log", "from": "agent", "to": "sql-lakehouse", "label": "Action log" },
      { "id": "e-agent-genie", "from": "agent", "to": "genie", "label": "Asks" },

      { "id": "e-dash", "from": "sql-lakehouse", "to": "dashboard", "flow": true },
      { "id": "e-genie", "from": "sql-lakehouse", "to": "genie", "flow": true },
      { "id": "e-app", "from": "sql-lakehouse", "to": "app", "flow": true },
      { "id": "e-app-agent", "from": "app", "to": "agent", "label": "Ask, revert, set guardrails" }
    ]
  }
