{
  "datasets": [
    {
      "name": "kpi_spend_margin",
      "displayName": "KPI: spend and margin, Apr-Sep vs Jan-Mar",
      "queryLines": [
        "SELECT post.monthly_discount_spend, pre.monthly_discount_spend AS monthly_discount_spend_pre,\n",
        "       post.monthly_incremental_margin, pre.monthly_incremental_margin AS monthly_incremental_margin_pre\n",
        "FROM (SELECT MEASURE(monthly_discount_spend) AS monthly_discount_spend,\n",
        "             MEASURE(monthly_incremental_margin) AS monthly_incremental_margin\n",
        "      FROM metrics_promotions WHERE send_policy = 'All eligible (Apr-Sep)') post\n",
        "CROSS JOIN (SELECT MEASURE(monthly_discount_spend) AS monthly_discount_spend,\n",
        "                   MEASURE(monthly_incremental_margin) AS monthly_incremental_margin\n",
        "            FROM metrics_promotions WHERE send_policy <> 'All eligible (Apr-Sep)') pre\n"
      ]
    },
    {
      "name": "kpi_coffee_anyway",
      "displayName": "KPI: Coffee + Croissant redemptions that would happen anyway",
      "queryLines": [
        "SELECT MEASURE(redemption_rate) AS redemption_rate,\n",
        "       MEASURE(redemptions_that_would_happen_anyway) AS would_happen_anyway\n",
        "FROM metrics_promotions\n",
        "WHERE promotion_id = 'PR01' AND send_policy = 'All eligible (Apr-Sep)'\n"
      ]
    },
    {
      "name": "kpi_targeting_gain",
      "displayName": "KPI: annual gain from uplift targeting",
      "queryLines": [
        "SELECT SUM(annual_gain_vs_blast) AS annual_gain_vs_blast\n",
        "FROM promo_portfolio\n"
      ]
    },
    {
      "name": "spend_vs_margin_trend",
      "displayName": "Discount spend vs incremental margin by month",
      "queryLines": [
        "SELECT month_end, 'Discount spend' AS measure, MEASURE(discount_spend) AS usd\n",
        "FROM metrics_promotions\n",
        "GROUP BY month_end\n",
        "UNION ALL\n",
        "SELECT month_end, 'Incremental margin' AS measure, MEASURE(incremental_margin) AS usd\n",
        "FROM metrics_promotions\n",
        "GROUP BY month_end\n",
        "ORDER BY month_end\n"
      ]
    },
    {
      "name": "redemption_vs_lift",
      "displayName": "Redemption rate vs measured lift, Apr-Sep",
      "queryLines": [
        "SELECT promotion, 'Redemption rate' AS measure, MEASURE(redemption_rate) AS rate\n",
        "FROM metrics_promotions\n",
        "WHERE send_policy = 'All eligible (Apr-Sep)'\n",
        "GROUP BY promotion\n",
        "UNION ALL\n",
        "SELECT promotion, 'Measured lift' AS measure, MEASURE(measured_lift) AS rate\n",
        "FROM metrics_promotions\n",
        "WHERE send_policy = 'All eligible (Apr-Sep)'\n",
        "GROUP BY promotion\n"
      ]
    },
    {
      "name": "margin_by_region",
      "displayName": "Incremental margin by region, Apr-Sep",
      "queryLines": [
        "SELECT region, promotion, MEASURE(incremental_margin) AS incremental_margin\n",
        "FROM metrics_promotions\n",
        "WHERE send_policy = 'All eligible (Apr-Sep)'\n",
        "GROUP BY region, promotion\n"
      ]
    },
    {
      "name": "tier_backtest",
      "displayName": "Measured lift by model tier",
      "queryLines": [
        "SELECT p.short_name AS promotion, b.tier, b.measured_uplift, b.treatment_sends, b.holdout_sends\n",
        "FROM tier_backtest b\n",
        "JOIN promotions p USING (promotion_id)\n",
        "WHERE b.holdout_sends >= 30\n"
      ]
    },
    {
      "name": "portfolio",
      "displayName": "Promotion portfolio",
      "queryLines": [
        "SELECT opportunity_rank, short_name AS promotion, eligible_members, persuadable_members,\n",
        "       redemption_rate_apr_sep, measured_uplift_apr_sep,\n",
        "       blast_net_margin_per_send, targeted_net_margin_per_send, annual_opportunity_targeted, status\n",
        "FROM promo_portfolio\n",
        "ORDER BY opportunity_rank\n"
      ]
    }
  ],
