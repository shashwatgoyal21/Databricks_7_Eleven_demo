[
  {
    "name": "Offer Engine",
    "story": "Customer 360 profiles feed a real-time decision endpoint that picks the best offer per shopper in milliseconds. A recommender scores every program and region and proposes changes ranked by profit, kept only if return on spend stays above the 10.1% target. The agent asks before changing any promotion; an approval changes which offers the endpoint sends, and Undo restores them. The app shows return on spend, recommendations and programs, with reports exported to EPM. No individual shoppers on screen.",
    "rowGrid": true,
    "columns": [
      "sources",
      "pipeline",
      "c360",
      "models",
      "serving",
      "agent",
      "consume"
